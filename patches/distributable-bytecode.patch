+// Options controlling how a bytecode artifact is serialized. The default value
+// ({ false, false }) reproduces the historical local-cache behavior exactly and
+// is what every existing caller gets. Cottontail opts in to the shipping/
+// distributable behavior by threading a non-default value through the encode /
+// generate entry points.
+struct BytecodeCacheOptions {
+    // When true, the artifact is meant to be shipped and reused across reboots:
+    // the per-boot bootSessionUUID gate is skipped at load time, leaving the
+    // per-binary JSC image version (m_cacheVersion) as the sole validity gate.
+    bool distributable { false };
+
+    // When true, the program/module source text is NOT embedded in the artifact
+    // (only offsets/positions are kept). Functions restored from such an artifact
+    // report `[native code]` from Function.prototype.toString, and load-time
+    // source-key validation ignores the (absent) source string.
+    bool stripSource { false };
+};
+
+JS_EXPORT_PRIVATE RefPtr<CachedBytecode> encodeCodeBlock(VM&, const SourceCodeKey&, const UnlinkedCodeBlock*, BytecodeCacheOptions = { });
+JS_EXPORT_PRIVATE RefPtr<CachedBytecode> encodeCodeBlock(VM&, const SourceCodeKey&, const UnlinkedCodeBlock*, FileSystem::FileHandle&, BytecodeCacheError&, BytecodeCacheOptions = { });
 
