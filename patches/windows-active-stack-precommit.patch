+    // A previous entry may have already committed this span. Query the lowest
+    // address the loop would touch: its page offset can differ from stackLimit's.
+    // VirtualQuery describes consecutive pages starting at the queried page,
+    // so also require that this committed, non-guard region reaches our frame.
+    // Recheck the current stack every time to handle migration and deeper entry.
+    const auto lastProbe = firstProbe - ((firstProbe - limit - 1) / pageSize) * pageSize;
+    MEMORY_BASIC_INFORMATION region { };
+    if (VirtualQuery(reinterpret_cast<void*>(lastProbe), &region, sizeof(region)) == sizeof(region)
+        && region.State == MEM_COMMIT && region.Protect == PAGE_READWRITE) {
+        const auto base = reinterpret_cast<uintptr_t>(region.BaseAddress);
+        if (firstProbe >= base && firstProbe - base < region.RegionSize)
+            return;
+    }
